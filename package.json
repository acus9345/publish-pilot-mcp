{
  "name": "publish-pilot-mcp",
  "version": "0.4.0",
  "description": "MCP server that lets Claude take a project from nothing to a published GitHub repo and npm/PyPI/crates.io package: preflight, login, scaffold, checks, publish, release.",
  "license": "MIT",
  "author": "acus9345 <acus9345@gmail.com>",
  "type": "module",
  "bin": {
    "publish-pilot-mcp": "dist/cli.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run build",
    "test": "vitest run",
    "prepack": "npm run build"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "claude",
    "publish",
    "npm",
    "pypi",
    "crates",
    "github",
    "release",
    "automation"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/acus9345/publish-pilot-mcp.git"
  },
  "homepage": "https://github.com/acus9345/publish-pilot-mcp#readme",
  "bugs": {
    "url": "https://github.com/acus9345/publish-pilot-mcp/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "eslint": "^10.13.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  }
}
